# ── 方式一：使用 Claude（默认）──────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── 方式二：使用 DeepSeek ────────────────────────────────────
# AI_REVIEW_API_KEY=sk-...               # DeepSeek API Key
# AI_REVIEW_BASE_URL=https://api.deepseek.com
# 运行时加 --model deepseek-chat

# ── 方式三：使用 OpenAI ──────────────────────────────────────
# AI_REVIEW_API_KEY=sk-...               # OpenAI API Key
# 运行时加 --model gpt-4o

# ── 方式四：使用 Ollama（本地，无需 API Key）─────────────────
# AI_REVIEW_BASE_URL=http://localhost:11434/v1
# 运行时加 --model llama3.2

# ── 通用优先级说明 ───────────────────────────────────────────
# AI_REVIEW_API_KEY 优先级最高，会覆盖 ANTHROPIC_API_KEY 和 OPENAI_API_KEY
# AI_REVIEW_BASE_URL 优先级高于 --base-url CLI 参数
